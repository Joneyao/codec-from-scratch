build/
*.o
*.obj
*.exe
*.out
*.yuv
*.raw
.DS_Store

# 编码器产出的二进制图片属于可再生成的产物，不入库。
# 保留 chart_data 下的 *.txt（配图脚本引用的真实测量数据）。
jpeg/encoder/out.jpg
jpeg/encoder/chart_data/*.jpg
jpeg/encoder/chart_data/*.png

# MJPEG 编码器产出：.avi 与解出的预览帧可再生成，不入库；
# 保留 chart_data/*.txt（每帧字节数等真实测量数据，配图脚本要读）。
mjpeg/encoder/out.avi
mjpeg/encoder/chart_data/*.png
# ffmpeg 生成的测试帧序列可一条命令再生成，不入库。
samples/mjpeg_frames/

# MJPEG 解码器产出：解出的帧序列、抠出的 JPEG、ffmpeg 对照帧都可一条命令
# 再生成，不入库；保留 chart_data/*.txt（逐帧 PSNR 等真实测量数据）。
mjpeg/decoder/out_frames/
mjpeg/decoder/ff_frames/
mjpeg/decoder/jpeg_frames/
mjpeg/decoder/chart_data/*.png
